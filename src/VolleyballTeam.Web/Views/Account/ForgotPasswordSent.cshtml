@{
    ViewData["Title"] = "Check your email";
}

<div class="card mx-auto max-w-md">
    <h1 class="mb-2 text-2xl font-bold">Check your email</h1>
    <p class="text-sm text-slate-600">If an account exists for that address, we've sent a link to reset the password. It may take a few minutes to arrive; check your spam folder too.</p>
    <p class="mt-6 text-center text-sm"><a class="font-medium text-club hover:underline" asp-action="Login">Back to sign in</a></p>
</div>
