@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot password";
}

<div class="card mx-auto max-w-md">
    <h1 class="mb-2 text-2xl font-bold">Forgot password</h1>
    <p class="mb-6 text-sm text-slate-600">Enter your email and we'll send you a link to choose a new password.</p>

    <form asp-action="ForgotPassword" method="post" class="space-y-4">
        <div asp-validation-summary="ModelOnly"></div>
        <div>
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-input" autocomplete="username" />
            <span asp-validation-for="Email"></span>
        </div>
        <button type="submit" class="btn-primary w-full">Send reset link</button>
    </form>

    <p class="mt-6 text-center text-sm"><a class="font-medium text-club hover:underline" asp-action="Login">Back to sign in</a></p>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
