@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Choose a new password";
}

<div class="card mx-auto max-w-md">
    <h1 class="mb-6 text-2xl font-bold">Choose a new password</h1>

    <form asp-action="ResetPassword" method="post" class="space-y-4">
        <div asp-validation-summary="ModelOnly"></div>
        <input type="hidden" asp-for="Email" />
        <input type="hidden" asp-for="Token" />

        <div>
            <label asp-for="Password" class="form-label"></label>
            <input asp-for="Password" class="form-input" autocomplete="new-password" />
            <span asp-validation-for="Password"></span>
            <span class="mt-1 block text-xs text-slate-500">At least 10 characters, with upper and lower case, a number and a symbol.</span>
        </div>

        <div>
            <label asp-for="ConfirmPassword" class="form-label"></label>
            <input asp-for="ConfirmPassword" class="form-input" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword"></span>
        </div>

        <button type="submit" class="btn-primary w-full">Change password</button>
    </form>

    <p class="mt-6 text-center text-sm"><a class="font-medium text-club hover:underline" asp-action="ForgotPassword">Request a new link</a></p>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
