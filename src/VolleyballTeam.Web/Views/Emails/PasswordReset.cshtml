@using VolleyballTeam.Web.Email
@model PasswordResetEmailModel
@{
    Layout = "/Views/Emails/_EmailLayout.cshtml";
    ViewData["Branding"] = Model.Branding;
}
<p style="margin:0 0 16px;">Hi @Model.FirstName,</p>
<p style="margin:0 0 24px;">Someone asked to reset your password. If it was you, choose a new one:</p>
<p style="margin:0 0 24px;">
    <a href="@Model.ResetUrl" style="display:inline-block;background:@Model.Branding.PrimaryColor;color:#ffffff;text-decoration:none;font-weight:bold;padding:12px 20px;border-radius:6px;">Choose a new password</a>
</p>
<p style="margin:0 0 8px;font-size:13px;color:#475569;">If the button doesn't work, paste this into your browser:</p>
<p style="margin:0 0 16px;font-size:13px;word-break:break-all;"><a href="@Model.ResetUrl" style="color:@Model.Branding.PrimaryColor;">@Model.ResetUrl</a></p>
<p style="margin:0;font-size:13px;color:#475569;">If it wasn't you, ignore this email. Your password hasn't changed.</p>
