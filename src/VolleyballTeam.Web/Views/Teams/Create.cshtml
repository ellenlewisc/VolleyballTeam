@model TeamCreateViewModel
@{
    ViewData["Title"] = "New team";
    var slug = Tenant.Club!.Slug;
}

<div class="card mx-auto max-w-lg">
    <h1 class="mb-1 text-2xl font-bold">New team</h1>
    <p class="mb-6 text-sm text-slate-500">For a team the club hasn't had before. Existing teams continue into a new season through <a class="font-medium text-club underline" asp-controller="Seasons" asp-action="Index" asp-route-club="@slug">Seasons</a>.</p>

    @if (Model.Seasons.Count == 0)
    {
        <p class="text-sm text-slate-600">Create a season first.</p>
        <a class="btn-primary mt-4" asp-controller="Seasons" asp-action="Create" asp-route-club="@slug">New season</a>
    }
    else
    {
        <form method="post" asp-action="Create" asp-route-club="@slug" class="space-y-4">
            <div asp-validation-summary="ModelOnly"></div>

            <div>
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-input" />
                <span asp-validation-for="Name"></span>
            </div>

            <div>
                <label asp-for="SeasonId" class="form-label"></label>
                <select asp-for="SeasonId" class="form-input" asp-items="@(new SelectList(Model.Seasons, nameof(SeasonRow.Id), nameof(SeasonRow.Name)))"></select>
                <span asp-validation-for="SeasonId"></span>
            </div>

            <div>
                <label asp-for="DisplayName" class="form-label"></label>
                <input asp-for="DisplayName" class="form-input" />
                <span asp-validation-for="DisplayName"></span>
            </div>

            <div class="grid gap-4 sm:grid-cols-2">
                <div>
                    <label asp-for="AgeGroup" class="form-label"></label>
                    <input asp-for="AgeGroup" class="form-input" />
                    <span asp-validation-for="AgeGroup"></span>
                </div>
                <div>
                    <label asp-for="Level" class="form-label"></label>
                    <input asp-for="Level" class="form-input" />
                    <span asp-validation-for="Level"></span>
                </div>
            </div>

            <div class="flex gap-3">
                <button type="submit" class="btn-primary">Create team</button>
                <a class="btn-secondary" asp-action="Index" asp-route-club="@slug">Cancel</a>
            </div>
        </form>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
