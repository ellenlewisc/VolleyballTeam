@{
    ViewData["Title"] = "Welcome";
}

<section class="card mx-auto max-w-2xl text-center">
    <h1 class="text-3xl font-bold tracking-tight">Run your volleyball club in one place</h1>
    <p class="mt-3 text-slate-600">
        Rosters, schedules, practice plans and parent updates for every team in your club.
        Access is by invitation from your club or coach.
    </p>
    <div class="mt-6">
        <a class="btn-primary" asp-controller="Account" asp-action="Login">Sign in</a>
    </div>
</section>
