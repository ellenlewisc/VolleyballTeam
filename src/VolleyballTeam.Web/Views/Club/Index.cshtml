@model ClubDashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="mb-6 flex flex-wrap items-end justify-between gap-4">
    <div>
        <h1 class="mb-1 text-2xl font-bold">@Model.ClubName</h1>
        <p class="text-slate-600">Your teams</p>
    </div>
    @if (Model.IsAdmin)
    {
        <a class="btn-primary" asp-controller="Teams" asp-action="Create" asp-route-club="@Tenant.Club!.Slug">New team</a>
    }
</div>

@if (Model.Current.Count == 0)
{
    <div class="card text-slate-600">You aren't on any current teams in this club yet.</div>
}
else
{
    <partial name="_TeamSeasonCards" model="Model.Current" />
}

@if (Model.Past.Count > 0)
{
    <h2 class="mb-3 mt-10 text-lg font-semibold">Past seasons</h2>
    <p class="mb-4 text-sm text-slate-500">Read-only history.</p>
    <partial name="_TeamSeasonCards" model="Model.Past" />
}
