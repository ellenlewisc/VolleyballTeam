@model ClubDashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<h1 class="mb-1 text-2xl font-bold">@Model.ClubName</h1>
<p class="mb-6 text-slate-600">Your teams</p>

@if (Model.Teams.Count == 0)
{
    <div class="card text-slate-600">You aren't on any teams in this club yet.</div>
}
else
{
    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        @foreach (var team in Model.Teams)
        {
            <li class="card">
                <span class="block text-lg font-semibold">@team.Name</span>
                <span class="block text-sm text-slate-500">@team.Season · @(team.Level ?? "—")</span>
                @if (team.Role is not null)
                {
                    <span class="mt-3 inline-block rounded-full bg-club/10 px-2.5 py-0.5 text-xs font-medium text-club">@team.Role</span>
                }
            </li>
        }
    </ul>
}
