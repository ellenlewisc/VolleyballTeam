@model IReadOnlyList<TeamSeasonCard>

<ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    @foreach (var team in Model)
    {
        <li>
            <a class="card block transition hover:border-club" asp-controller="TeamSeasons" asp-action="Show" asp-route-club="@Tenant.Club!.Slug" asp-route-id="@team.Id">
                <span class="block text-lg font-semibold">@team.DisplayName</span>
                <span class="block text-sm text-slate-500">@team.SeasonName · @(team.AgeGroup ?? "—") · @(team.Level ?? "—")</span>
                <span class="mt-3 flex flex-wrap gap-2">
                    <partial name="_SeasonStatusBadge" model="team.SeasonStatus" />
                    @if (team.StaffRole is not null)
                    {
                        <span class="inline-block rounded-full bg-club/10 px-2.5 py-0.5 text-xs font-medium text-club">@StaffRoleNames.Title(team.StaffRole)</span>
                    }
                </span>
            </a>
        </li>
    }
</ul>
