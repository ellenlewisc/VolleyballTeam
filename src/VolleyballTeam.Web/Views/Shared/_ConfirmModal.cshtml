<dialog id="confirm-modal" class="m-auto w-full max-w-md rounded-lg p-0 shadow-xl backdrop:bg-slate-900/50">
    <div class="p-6">
        <h2 id="confirm-modal-title" class="mb-2 text-lg font-semibold">Are you sure?</h2>
        <p id="confirm-modal-message" class="text-sm text-slate-600"></p>
    </div>
    <div class="flex justify-end gap-3 border-t border-slate-200 bg-slate-50 px-6 py-4">
        <button type="button" class="btn-secondary" data-confirm-cancel>Cancel</button>
        <button type="button" class="btn-primary" data-confirm-accept>Confirm</button>
    </div>
</dialog>
