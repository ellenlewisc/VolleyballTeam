@if (TempData[ClubScopedController.FlashMessage] is string message)
{
    <div class="mb-6 rounded-md border border-green-200 bg-green-50 p-3 text-sm text-green-800" role="status">@message</div>
}
@if (TempData[ClubScopedController.FlashError] is string error)
{
    <div class="mb-6 rounded-md border border-red-200 bg-red-50 p-3 text-sm text-red-700" role="alert">@error</div>
}
