@model SeasonFormViewModel
@{
    var isNew = Model.Id is null;
    ViewData["Title"] = isNew ? "New season" : $"Edit {Model.Name}";
    var slug = Tenant.Club!.Slug;
}

<div class="card mx-auto max-w-lg">
    <h1 class="mb-1 text-2xl font-bold">@(isNew ? "New season" : "Edit season")</h1>
    <p class="mb-6 text-sm text-slate-500">
        @(isNew ? "It starts as Upcoming, so you can set up teams before it begins." : "Dates are for reference; starting and archiving the season is done from the Seasons list.")
    </p>

    <form method="post" asp-action="@(isNew ? "Create" : "Edit")" asp-route-club="@slug" asp-route-id="@Model.Id" class="space-y-4">
        <div asp-validation-summary="ModelOnly"></div>

        <div>
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-input" />
            <span asp-validation-for="Name"></span>
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
            <div>
                <label asp-for="StartsOn" class="form-label"></label>
                <input asp-for="StartsOn" class="form-input" />
                <span asp-validation-for="StartsOn"></span>
            </div>
            <div>
                <label asp-for="EndsOn" class="form-label"></label>
                <input asp-for="EndsOn" class="form-input" />
                <span asp-validation-for="EndsOn"></span>
            </div>
        </div>

        <div class="flex gap-3">
            <button type="submit" class="btn-primary">@(isNew ? "Create season" : "Save")</button>
            <a class="btn-secondary" asp-action="Index" asp-route-club="@slug">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
