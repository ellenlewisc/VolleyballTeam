@model SeasonCreateViewModel
@{
    ViewData["Title"] = "New season";
    var slug = Tenant.Club!.Slug;
}

<div class="card mx-auto max-w-lg">
    <h1 class="mb-1 text-2xl font-bold">New season</h1>
    <p class="mb-6 text-sm text-slate-500">It starts as Upcoming, so you can set up teams before it begins.</p>

    <form method="post" asp-action="Create" asp-route-club="@slug" class="space-y-4">
        <div asp-validation-summary="ModelOnly"></div>

        <div>
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-input" />
            <span asp-validation-for="Name"></span>
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
            <div>
                <label asp-for="StartsOn" class="form-label"></label>
                <input asp-for="StartsOn" class="form-input" />
                <span asp-validation-for="StartsOn"></span>
            </div>
            <div>
                <label asp-for="EndsOn" class="form-label"></label>
                <input asp-for="EndsOn" class="form-input" />
                <span asp-validation-for="EndsOn"></span>
            </div>
        </div>

        <div class="flex gap-3">
            <button type="submit" class="btn-primary">Create season</button>
            <a class="btn-secondary" asp-action="Index" asp-route-club="@slug">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
