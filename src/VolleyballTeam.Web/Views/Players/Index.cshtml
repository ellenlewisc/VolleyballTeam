@model PlayersPageViewModel
@{
    ViewData["Title"] = "Players";
    var slug = Tenant.Club!.Slug;
}

@section Styles {
    <link rel="stylesheet" href="~/lib/datatables/css/dataTables.dataTables.min.css" />
}

<div class="mb-6 flex flex-wrap items-end justify-between gap-4">
    <div>
        <h1 class="mb-1 text-2xl font-bold">Players</h1>
        <p class="text-sm text-slate-600">
            @(Model.IsAdmin
                ? "Every player who has played for the club, across all teams and seasons."
                : "Players on your teams.")
            Players are added from a team's roster.
        </p>
    </div>

    @if (Model.Teams.Count > 0)
    {
        <div>
            <label class="form-label" for="players-team">Team</label>
            <select class="form-input" id="players-team" data-players-team>
                @if (Model.IsAdmin)
                {
                    <option value="" selected="@(Model.SelectedTeamSeasonId is null)">All teams</option>
                }
                @foreach (var team in Model.Teams)
                {
                    <option value="@team.Id" selected="@(team.Id == Model.SelectedTeamSeasonId)">@team.Name</option>
                }
            </select>
        </div>
    }
</div>

@if (!Model.IsAdmin && Model.Teams.Count == 0)
{
    <div class="card text-slate-600">You aren't on any team's staff yet, so there are no players to show.</div>
}
else
{
    <div class="card">
        <div id="players-antiforgery">@Html.AntiForgeryToken()</div>
        <table id="players-table" class="w-full text-sm"
               data-source="@Url.Action("Data", "Players", new { club = slug })">
            <thead>
                <tr>
                    <th>Player</th>
                    <th>Grad year</th>
                    <th>Current teams</th>
                    <th>Guardians</th>
                </tr>
            </thead>
        </table>
    </div>
}

@section Scripts {
    <script src="~/lib/datatables/js/dataTables.min.js"></script>
    <script src="~/js/players.js" asp-append-version="true"></script>
}
